#!/usr/bin/env bash
# labwc's own autostart script (~/.config/labwc/autostart), for a Raspberry
# Pi OS Desktop exhibit build. install.sh writes this instead of a
# ~/.config/autostart/*.desktop entry on a labwc session (Raspberry Pi OS
# Bookworm's default compositor): that XDG autostart convention goes through
# an extra lxsession-xdg-autostart step which, on labwc, did not reliably run
# at real boot -- confirmed on repeated cold reboots of the actual exhibit
# Pi: the three lines below (labwc's own system default) came up fine every
# time, kutta never did without this file. Launching kutta directly here,
# the same way those three lines already are, is what labwc actually runs
# reliably.
/usr/bin/lwrespawn /usr/bin/pcmanfm-pi &
/usr/bin/lwrespawn /usr/bin/wf-panel-pi &
/usr/bin/kanshi &

# The short sleep gives WiFi/DHCP a little more time to settle before kutta
# binds its UDP listener.
#
# -udp :9000 is a plain wildcard bind for unicast, not the multicast group
# this used to use: on the exhibit's wireless network, multicast from the knob
# box never reached this machine, which enterprise WLANs commonly drop between
# their clients. The knob box now sends unicast straight to
# this Pi's DHCP-reserved address as well (KUTTA_UNICAST_IP in
# esp32_knob_controller.ino). Binding the wildcard rather than that specific
# address keeps the Pi's own IP out of this launch line entirely, so a lease
# or reservation change can't silently break startup.
#
# To go back to multicast (a hotspot, or a dedicated exhibit AP that passes
# it), this becomes -udp 239.192.1.1:9000 and nothing else changes -- the knob
# box sends to both destinations, so it never needs reflashing for this.
sleep 3
cd __KUTTA_DIR__ && DISPLAY=:0 ./kutta -scene __KUTTA_DIR__/cx300wing.afoil -kiosk -mode speed -particles=false -streamlines -tps 30 -substeps 2 -label -demo 30 -max-kn 150 -udp :9000 > /tmp/kutta.log 2>&1 &
