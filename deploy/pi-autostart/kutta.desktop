[Desktop Entry]
Type=Application
Name=Kutta Wind Tunnel
Comment=Launches the kutta wind-tunnel exhibit display on login
# -udp :9000 is a wildcard unicast bind; see labwc-autostart for why this is
# not the multicast group any more, and how to switch back.
Exec=__KUTTA_DIR__/kutta -scene __KUTTA_DIR__/cx300wing.afoil -kiosk -mode speed -particles=false -streamlines -tps 30 -substeps 2 -label -demo 30 -max-kn 150 -udp :9000
Path=__KUTTA_DIR__
X-GNOME-Autostart-enabled=true
