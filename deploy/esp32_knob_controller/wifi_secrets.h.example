// Copy this file to wifi_secrets.h (gitignored) and fill in your networks.
// wifi_secrets.h is never committed, so credentials never end up in git.
//
// Up to three networks, tried strictly in order by connectWiFi(): _1 is the
// preferred network (the exhibit's own AP), _2 and _3 are optional fallbacks
// -- a phone hotspot, say, for setting up somewhere the main network doesn't
// reach yet. Leave the ones you don't need commented out; the WIFI_NETWORKS
// table in esp32_knob_controller.ino #ifdefs out any slot that isn't defined.
//
// Whichever network the knob box lands on, the Pi running kutta has to be on
// that same network: the control protocol is UDP multicast on one L2 segment.

#pragma once

#define WIFI_SSID_1 "your-network-name"
#define WIFI_PASSWORD_1 "your-network-password"

// #define WIFI_SSID_2 "your-phone-hotspot"
// #define WIFI_PASSWORD_2 "your-hotspot-password"

// #define WIFI_SSID_3 "another-fallback"
// #define WIFI_PASSWORD_3 "another-password"

// Optional: the address of the machine running kutta, for networks that drop
// multicast between their clients (enterprise WLANs commonly do). Give that
// machine a DHCP reservation first, and run kutta with -udp :9000 rather than
// -udp 239.192.1.1:9000. Messages go to both destinations when this is set, so
// the box still works unchanged anywhere multicast does get through.
// It lives here rather than in the sketch because it differs per installation.

// #define KUTTA_UNICAST_IP "10.0.0.42"
